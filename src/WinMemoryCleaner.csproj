<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinMemoryCleaner</RootNamespace>
    <AssemblyName>WinMemoryCleaner</AssemblyName>
    <ApplicationIcon>Resources\Images\win-memory-cleaner.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>WinMemoryCleaner.App</StartupObject>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>WinMemoryCleaner.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>

    <!-- Keep the historical output layout (bin\Release\WinMemoryCleaner.exe) so every
         existing CI workflow, packaging script and release path keeps working. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS3001,CS3003,CS1591</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- Properties\AssemblyInfo.cs is the single source of assembly metadata. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon / color types, so keep the
         implicit global usings out of the way of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test sources are compiled by WinMemoryCleaner.Tests.csproj only.
         Keeping them out of the shipping assembly removes the NUnit dependency
         from a binary that runs with administrator privileges. -->
    <Compile Remove="Test\**\*.cs" />
    <None Remove="Test\**\*.cs" />
    <!-- The tests project owns these; the app must not compile them. -->
    <Compile Remove="WinMemoryCleaner.Tests.csproj" />
    <None Remove="packages\**\*" />
    <None Remove="packages.config" />
    <None Remove="packages.lock.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.ServiceProcess" />
    <!-- JavaScriptSerializer lives in System.Web.Extensions. The WPF markup
         compiler also needs System.Web resolvable, so reference it explicitly. -->
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Localization / theme payloads stay embedded under their historical
         manifest names: WinMemoryCleaner.Resources.Localization.<name>.json -->
    <EmbeddedResource Include="Resources\Localization\*.json" />
    <EmbeddedResource Include="Resources\Themes\*.json" />
    <Resource Include="Resources\Images\win-memory-cleaner.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="nuget.config" />
  </ItemGroup>

</Project>